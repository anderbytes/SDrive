package fshttp

import (
	"context"
	"crypto/tls"
	"errors"
	"io"
	"net"
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/rclone/rclone/fs/rc"
)

type partialNetworkConn struct{ net.Conn }

func (partialNetworkConn) Read(b []byte) (int, error) { copy(b, "rx"); return 2, io.EOF }
func (partialNetworkConn) Write(b []byte) (int, error) {
	return 1, errors.New("synthetic partial write")
}

func TestNetworkTransportIncludesTLS(t *testing.T) {
	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { _, _ = io.WriteString(w, "fixture") }))
	defer server.Close()
	ctx := context.Background()
	call := rc.Calls.Get("sdrive/network").Fn
	if _, err := call(ctx, rc.Params{"action": "start", "session": "tls"}); err != nil {
		t.Fatal(err)
	}
	transport := &http.Transport{DialContext: NewDialer(ctx).DialContext, TLSClientConfig: &tls.Config{InsecureSkipVerify: true}}
	defer transport.CloseIdleConnections()
	client := &http.Client{Transport: transport}
	response, err := client.Get(server.URL)
	if err != nil {
		t.Fatal(err)
	}
	body, err := io.ReadAll(response.Body)
	response.Body.Close()
	if err != nil || string(body) != "fixture" {
		t.Fatal(string(body), err)
	}
	got, err := call(ctx, rc.Params{"action": "stats", "session": "tls"})
	if err != nil || got["sent"].(int64) <= 100 || got["received"].(int64) <= int64(len(body)) {
		t.Fatal(got, err)
	}
}

func TestNetworkTransportCountsPartialIO(t *testing.T) {
	call := rc.Calls.Get("sdrive/network").Fn
	ctx := context.Background()
	if _, err := call(ctx, rc.Params{"action": "start", "session": "partial-io"}); err != nil {
		t.Fatal(err)
	}
	c := &timeoutConn{Conn: partialNetworkConn{}}
	if n, err := c.Read(make([]byte, 4)); n != 2 || err != io.EOF {
		t.Fatal(n, err)
	}
	if n, err := c.Write([]byte("data")); n != 1 || err == nil {
		t.Fatal(n, err)
	}
	got, err := call(ctx, rc.Params{"action": "stats", "session": "partial-io"})
	if err != nil || got["sent"] != int64(1) || got["received"] != int64(2) {
		t.Fatal(got, err)
	}
}
