// Wails loads the application window icon from resource 3.
3 ICON "sdrive.ico"

1 VERSIONINFO
 FILEVERSION @VERSION_NUMBER@
 PRODUCTVERSION @VERSION_NUMBER@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SDrive - Open source remote storage\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "SDrive\0"
            VALUE "ProductName", "SDrive\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
